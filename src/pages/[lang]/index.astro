---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import { content, img, pageUrl, LANGS, type Lang } from '../../lib/content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const c = content[lang];
const ui = c.ui;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const SEP = lang === 'zh' ? '・' : ' · ';
const COLON = lang === 'zh' ? '：' : ': ';
const sections = ['about', 'publications', 'research', 'videos', 'awards', 'activities'] as const;
const statusClass = (id: string) => (id.startsWith('ieee') ? 'review' : id.startsWith('csmmt') ? 'ok' : 'plain');
const pubYear = (id: string) => (id.includes('thesis') ? (lang === 'zh' ? '114 學年度' : '2025–26') : '2026');
const projectById = Object.fromEntries(c.research.map((r) => [r.id, r]));
const links = [
  [ui.contact.email, `mailto:${c.contact.email}`],
  [ui.contact.linkedin, c.contact.linkedin],
  [ui.contact.github, c.contact.github],
  [ui.contact.makerworld, c.contact.makerworld],
] as const;
---
<Base lang={lang} c={c}>
  <a class="skip-link" href="#main">{ui.skip}</a>

  <header class="topbar">
    <div class="wrap">
      <a class="brand" href="#top">{c.meta.name}</a>
      <nav class="nav" aria-label={lang === 'zh' ? '頁面區塊' : 'Sections'}>
        <ul>{sections.map((s) => <li><a href={`#${s}`}>{ui.nav[s]}</a></li>)}</ul>
      </nav>
      <div class="tools">
        <a class="btn" href={pageUrl(other)} hreflang={other === 'zh' ? 'zh-Hant-TW' : 'en'} lang={other === 'zh' ? 'zh-Hant-TW' : 'en'}
           aria-label={ui.switchLabel} data-lang-switch={other}>{ui.switchTo}</a>
        <button class="btn" type="button" data-theme-toggle aria-label={ui.theme} title={ui.theme}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" /></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- ===== 標題欄＋簡介 ===== -->
    <div class="sheet" id="top">
      <div class="wrap" id="about">
        <div class="titleblock">
          <div class="photo">
            <Image src={img(c.meta.photo.file)} alt={c.meta.photo.alt} widths={[224, 400]} sizes="(max-width: 760px) 112px, 200px" loading="eager" fetchpriority="high" />
          </div>
          <div class="tb-name"><h1>{c.meta.name}</h1><span class="alt">{c.meta.nameAlt}</span></div>
          <div class="tb-row">
            <div><span class="k">{ui.tb.institution}</span><span class="v">{c.hero.institution}</span></div>
            <div><span class="k">{ui.tb.department}</span><span class="v">{c.hero.department}</span></div>
            <div><span class="k">{ui.tb.standing}</span><span class="v">{c.hero.standing}</span></div>
          </div>
          <div class="tb-row2">
            <div><span class="k">{ui.tb.interests}</span><span class="v">{c.hero.interests.join(lang === 'zh' ? '、' : ' · ')}</span></div>
            <div><span class="k">{ui.tb.next}</span><span class="v">{c.hero.next}</span></div>
          </div>
        </div>
        <div class="bio">
          <p>{c.hero.summary}</p>
          <p class="links">
            {links.map(([label, href], i) => <>{i > 0 && <span aria-hidden="true"> ／ </span>}<a href={href} rel={href.startsWith('mailto') ? undefined : 'me noopener'}>{label}</a></>)}
          </p>
        </div>
      </div>
    </div>

    <div class="wrap">
      <!-- ===== 著作 ===== -->
      <section class="section" id="publications" aria-labelledby="h-pubs">
        <div class="section-head"><h2 id="h-pubs">{ui.sections.publications}</h2><span class="no num" aria-hidden="true">01</span></div>
        <table class="pubs">
          <thead><tr><th class="k y">{ui.labels.year}</th><th class="k">{ui.labels.title}</th><th class="k s">{ui.labels.status}</th></tr></thead>
          <tbody>
            {c.publications.map((p) => (
              <tr>
                <td class="y num">{pubYear(p.id)}</td>
                <td>
                  <span class="pub-title" lang={/[一-鿿]/.test(p.title) ? 'zh-Hant-TW' : 'en'}>{p.title}</span>
                  {p.titleEn && <span class="pub-title-alt" lang="en">{p.titleEn}</span>}
                  <span class="pub-venue">{p.type}{SEP}{p.venue}</span>
                  <details>
                    <summary>{ui.labels.showAbstract}</summary>
                    <p>{p.abstract}</p>
                  </details>
                </td>
                <td class="s">
                  {p.status && <span class:list={['chip', statusClass(p.id)]}>{p.status}</span>}
                  <div class="note num">{p.date}</div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="note">{ui.labels.abstractOnly}</p>
      </section>

      <!-- ===== 研究與專案 ===== -->
      <section class="section" id="research" aria-labelledby="h-research">
        <div class="section-head"><h2 id="h-research">{ui.sections.research}</h2><span class="no num" aria-hidden="true">02</span></div>
        {c.research.map((r, idx) => (
          <article class="project" id={r.id} aria-labelledby={`t-${r.id}`}>
            <div class="proj-grid">
              <div class="thumb">
                <Image src={img(r.thumb)} alt={r.images?.find((i) => i.file === r.thumb)?.alt ?? ''} widths={[320, 640]} sizes="(max-width: 700px) 100vw, 300px" loading="lazy" />
              </div>
              <div class="proj-text">
                <span class="cat num">{[`02.${idx + 1}`, r.category, r.period].filter(Boolean).join(SEP)}</span>
                <h3 id={`t-${r.id}`}>{r.title}</h3>
                <p class="org">{r.org}{r.advisor && <>{SEP}{ui.labels.advisor}{COLON}{r.advisor}</>}</p>
                <p>{r.summary}</p>
                <p class="role"><strong>{ui.labels.myRole}{COLON}</strong>{r.brief}</p>
                {r.video && <a class="btn watch" href={`#video-${r.video.youtubeId}`}>▶ {ui.labels.video}</a>}
              </div>
            </div>
            <details class="more">
              <summary>{ui.labels.more}</summary>
              <div class="more-body">
                <div class="more-grid">
                  {r.method && <div><h4>{ui.labels.method}</h4><ul>{r.method.map((m) => <li>{m}</li>)}</ul></div>}
                  {r.system && <div><h4>{ui.labels.system}</h4><p>{r.system}</p></div>}
                  {r.design && <div><h4>{ui.labels.design}</h4><ul>{r.design.map((m) => <li>{m}</li>)}</ul></div>}
                  {r.contributions?.length > 0 && <div><h4>{ui.labels.contributions}</h4><ul>{r.contributions.map((m) => <li>{m}</li>)}</ul></div>}
                  {r.team && <div><h4>{ui.labels.team}</h4><p>{r.team}</p></div>}
                  {r.challenges && <div><h4>{ui.labels.challenges}</h4><ul>{r.challenges.map((m) => <li>{m}</li>)}</ul></div>}
                  {r.results?.length > 0 && <div><h4>{ui.labels.results}</h4><ul class="num">{r.results.map((m) => <li>{m}</li>)}</ul></div>}
                  {r.reflection && <div><h4>{ui.labels.reflection}</h4><p>{r.reflection}</p></div>}
                </div>
                {r.images?.length > 0 && (
                  <div class="figs">
                    {r.images.map((im, k) => (
                      <figure class:list={{ wide: im.wide }}>
                        <Image src={img(im.file)} alt={im.alt} widths={im.wide ? [560, 1040] : [280, 560]}
                               sizes={im.wide ? '(max-width: 860px) 100vw, 520px' : '(max-width: 860px) 50vw, 250px'} loading="lazy" />
                        <figcaption><span class="num">{ui.labels.figure} {idx + 1}.{k + 1}</span>{lang === 'zh' ? '　' : '  '}{im.caption}</figcaption>
                      </figure>
                    ))}
                  </div>
                )}
                <ul class="tags">{r.tags.map((t) => <li>{t}</li>)}</ul>
              </div>
            </details>
          </article>
        ))}
      </section>

      <!-- ===== 影片 ===== -->
      <section class="section" id="videos" aria-labelledby="h-videos">
        <div class="section-head"><h2 id="h-videos">{ui.sections.videos}</h2><span class="no num" aria-hidden="true">03</span></div>
        <div class="videos">
          {c.videos.map((v) => (
            <figure class="video" id={`video-${v.youtubeId}`}>
              <Video id={v.youtubeId} title={v.title} playLabel={ui.labels.playVideo} openLabel={ui.labels.openYoutube} />
              <figcaption>
                <span class="t">{v.title}</span>
                <span class="c">{v.caption}</span>
                {projectById[v.relatedProject] && <> <a href={`#${v.relatedProject}`}>→ {projectById[v.relatedProject].title}</a></>}
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="note">{ui.videoConsent}</p>
      </section>

      <!-- ===== 獲獎與計畫 ===== -->
      <section class="section" id="awards" aria-labelledby="h-awards">
        <div class="section-head"><h2 id="h-awards">{ui.sections.awards}</h2><span class="no num" aria-hidden="true">04</span></div>
        <div class="ledger">
          {c.awards.map((a) => (
            <div>
              <div class="num">{a.year}</div>
              <div><div class="t">{a.title}</div><div class="sub">{a.org}</div>{a.note && <div class="sub">{a.note}</div>}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== 其他 ===== -->
      <section class="section" id="activities" aria-labelledby="h-acts">
        <div class="section-head"><h2 id="h-acts">{ui.sections.activities}</h2><span class="no num" aria-hidden="true">05</span></div>
        <div class="acts">
          {c.activities.map((a) => (
            <article class="act">
              {a.images?.[0] && <Image src={img(a.images[0].file)} alt={a.images[0].alt} widths={[360, 720]} sizes="(max-width: 700px) 100vw, 360px" loading="lazy" />}
              <div class="body">
                <h3>{a.title}</h3>
                <div class="sub">{a.org}{a.role && `${SEP}${a.role}`}</div>
                <p>{a.summary}</p>
                {a.link && <a href={a.link} rel="noopener">{ui.labels.link} ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>

  <footer class="footer">
    <div class="wrap">
      <span>© 2026 {c.meta.name}{SEP}{ui.updated} <span class="num">{c.updated}</span>{SEP}<a href={`mailto:${c.contact.email}`}>{c.contact.email}</a></span>
      <span class="tools"><button class="btn" type="button" onclick="window.print()">{ui.print}</button></span>
    </div>
  </footer>

  <script>
    // 語言切換：記住選擇，並保留目前看到的區塊（#hash）。
    document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
      a.addEventListener('click', (e) => {
        try { localStorage.setItem('lang', a.dataset.langSwitch!); } catch {}
        if (location.hash) { e.preventDefault(); location.href = a.href + location.hash; }
      });
    });
    // 深色／淺色切換：記在 localStorage。
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    });
    // 從影片連到專案時，自動展開該專案的詳細內容。
    const openTarget = () => {
      if (!location.hash) return;
      document.getElementById(decodeURIComponent(location.hash.slice(1)))?.querySelector('details.more')?.setAttribute('open', '');
    };
    addEventListener('hashchange', openTarget); openTarget();
  </script>
</Base>
