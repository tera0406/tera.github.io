---
// 根網址：依「上次選擇」或瀏覽器語言，自動轉到 /zh/ 或 /en/。
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site!.toString().replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Chao-Yuan Chiang 姜兆源</title>
  <meta name="description" content="Personal academic website of Chao-Yuan (Tera) Chiang, National Sun Yat-sen University. 姜兆源的個人學術網站。" />
  <link rel="canonical" href={`${site}${base}/en/`} />
  <link rel="alternate" hreflang="en" href={`${site}${base}/en/`} />
  <link rel="alternate" hreflang="zh-Hant-TW" href={`${site}${base}/zh/`} />
  <link rel="alternate" hreflang="x-default" href={`${site}${base}/`} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <script is:inline define:vars={{ base }}>
    (function () {
      var lang = null;
      try { lang = localStorage.getItem('lang'); } catch (e) {}
      if (lang !== 'zh' && lang !== 'en') {
        var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
        lang = /^zh/i.test(prefs[0] || '') ? 'zh' : 'en';
      }
      location.replace(base + '/' + lang + '/' + location.hash);
    })();
  </script>
</head>
<body>
  <main class="wrap" style="padding:48px 16px">
    <h1>Chao-Yuan Chiang 姜兆源</h1>
    <p><a href={`${base}/en/`} hreflang="en">English</a> ・ <a href={`${base}/zh/`} hreflang="zh-Hant-TW" lang="zh-Hant-TW">繁體中文</a></p>
  </main>
</body>
</html>
